{
  "name": "godotlsp",
  "displayName": "godotlsp:独立 GDScript 语言服务器",
  "description": "独立于 Godot 引擎运行的 GDScript 语言服务器:悬停文档、补全、导航、诊断与格式化,无需打开 Godot 编辑器。",
  "version": "0.1.10",
  "publisher": "SantaChains",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SantaChains/godotlsp",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "godot",
    "gdscript",
    "lsp",
    "language server",
    "gamedev"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "godotlsp 会运行由工作区配置的二进制文件。",
      "restrictedConfigurations": [
        "godotlsp.path",
        "godotlsp.godotExecutable"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "godotlsp",
          "title": "godotlsp",
          "icon": "./icons/godot_mono.svg"
        }
      ]
    },
    "views": {
      "godotlsp": [
        {
          "id": "godotlsp.symbols",
          "name": "当前文件符号"
        },
        {
          "id": "godotlsp.project",
          "name": "项目结构"
        },
        {
          "id": "godotlsp.scene",
          "name": "场景结构"
        },
        {
          "id": "godotlsp.connections",
          "name": "信号连接"
        }
      ]
    },
    "languages": [
      {
        "id": "gdscript",
        "aliases": [
          "GDScript",
          "gdscript"
        ],
        "extensions": [
          ".gd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "godot-resource",
        "aliases": [
          "Godot Resource",
          "godotresource"
        ],
        "extensions": [
          ".tscn",
          ".tres"
        ],
        "configuration": "./language-configurations/godot-resource.json"
      },
      {
        "id": "godot-project",
        "aliases": [
          "Godot Project",
          "godotproject"
        ],
        "extensions": [
          ".godot",
          ".import",
          ".gdextension",
          ".cfg"
        ],
        "configuration": "./language-configurations/godot-project.json"
      },
      {
        "id": "godot-uid",
        "aliases": [
          "Godot UID"
        ],
        "extensions": [
          ".uid"
        ],
        "configuration": "./language-configurations/godot-project.json"
      }
    ],
    "grammars": [
      {
        "language": "gdscript",
        "scopeName": "source.gdscript",
        "path": "./syntaxes/GDScript.tmLanguage.json"
      },
      {
        "language": "godot-resource",
        "scopeName": "source.godot.resource",
        "path": "./syntaxes/GodotResource.tmLanguage.json"
      },
      {
        "language": "godot-project",
        "scopeName": "source.godot.project",
        "path": "./syntaxes/GodotProject.tmLanguage.json"
      },
      {
        "language": "godot-uid",
        "scopeName": "source.godot.uid",
        "path": "./syntaxes/GodotUid.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gdscript",
        "path": "./snippets/gdscript.json"
      }
    ],
    "configurationDefaults": {
      "[gdscript]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": true,
        "editor.tabSize": 4
      },
      "[godot-resource]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": true,
        "editor.tabSize": 4
      }
    },
    "commands": [
      {
        "command": "godotlsp.restart",
        "title": "重启服务器",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.showOutput",
        "title": "显示输出",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.runProject",
        "title": "运行项目",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.runScene",
        "title": "运行当前场景",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.switchSource",
        "title": "脚本与场景互相跳转",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.symbols.refresh",
        "title": "刷新符号",
        "category": "godotlsp",
        "icon": "$(refresh)"
      },
      {
        "command": "godotlsp.project.refresh",
        "title": "刷新项目结构",
        "category": "godotlsp",
        "icon": "$(refresh)"
      },
      {
        "command": "godotlsp.scene.refresh",
        "title": "刷新场景结构",
        "category": "godotlsp",
        "icon": "$(refresh)"
      },
      {
        "command": "godotlsp.connections.refresh",
        "title": "刷新信号连接",
        "category": "godotlsp",
        "icon": "$(refresh)"
      },
      {
        "command": "godotlsp.goto",
        "title": "跳转到声明",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.openConnection",
        "title": "打开场景连接",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.tree.copyName",
        "title": "复制名称",
        "category": "godotlsp",
        "icon": "$(copy)"
      },
      {
        "command": "godotlsp.tree.copyRef",
        "title": "复制位置引用",
        "category": "godotlsp",
        "icon": "$(link)"
      },
      {
        "command": "godotlsp.symbols.filter",
        "title": "过滤符号",
        "category": "godotlsp",
        "icon": "$(filter)"
      },
      {
        "command": "godotlsp.project.filter",
        "title": "过滤项目结构",
        "category": "godotlsp",
        "icon": "$(filter)"
      },
      {
        "command": "godotlsp.scene.filter",
        "title": "过滤场景结构",
        "category": "godotlsp",
        "icon": "$(filter)"
      },
      {
        "command": "godotlsp.connections.filter",
        "title": "过滤信号连接",
        "category": "godotlsp",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "godotlsp.symbols.refresh",
          "when": "view == godotlsp.symbols",
          "group": "navigation"
        },
        {
          "command": "godotlsp.project.refresh",
          "when": "view == godotlsp.project",
          "group": "navigation"
        },
        {
          "command": "godotlsp.scene.refresh",
          "when": "view == godotlsp.scene",
          "group": "navigation"
        },
        {
          "command": "godotlsp.connections.refresh",
          "when": "view == godotlsp.connections",
          "group": "navigation"
        },
        {
          "command": "godotlsp.symbols.filter",
          "when": "view == godotlsp.symbols",
          "group": "navigation@2"
        },
        {
          "command": "godotlsp.project.filter",
          "when": "view == godotlsp.project",
          "group": "navigation@2"
        },
        {
          "command": "godotlsp.scene.filter",
          "when": "view == godotlsp.scene",
          "group": "navigation@2"
        },
        {
          "command": "godotlsp.connections.filter",
          "when": "view == godotlsp.connections",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "godotlsp.tree.copyName",
          "when": "viewItem == godotlsp.copyable",
          "group": "9_copy@1"
        },
        {
          "command": "godotlsp.tree.copyRef",
          "when": "viewItem == godotlsp.copyable",
          "group": "9_copy@2"
        }
      ]
    },
    "configuration": {
      "title": "godotlsp",
      "properties": {
        "godotlsp.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "machine-overridable",
          "markdownDescription": "`godotlsp` 服务器可执行文件的路径。留空时优先使用扩展自带二进制(server/),否则回退到 `PATH` 中的 `godotlsp`。支持 `${workspaceFolder}` 与 `~`。"
        },
        "godotlsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "关闭:不记录通信内容。",
            "消息:记录编辑器与 godotlsp 之间的 LSP 请求/响应。",
            "详细:在消息级别之上额外记录每个报文的完整内容。"
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "把编辑器与 godotlsp 之间的 LSP 通信记录到 **godotlsp** 输出通道,便于排查问题。"
        },
        "godotlsp.completion.snippets": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "补全中的上下文感知代码片段:输入 `func _` 时按宿主类给出虚方法模板(`_ready`/`_process`/`_draw` 等),语句位给出高频调用模板。与客户端 snippet 支持协商独立生效。"
        },
        "godotlsp.completion.fileWords": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "把当前文件内出现过的自定义标识符(局部变量、出现 ≥2 次的词)加入补全。默认关闭:VSCode 的 `editor.wordBasedSuggestions` 已提供同类补全,开启后两者会同时出现。对 nvim/zed/helix 等无内置词条补全的编辑器建议开启。"
        },
        "godotlsp.completion.frequencyBoost": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "按语料统计的 API 使用频率对补全排序加权(构建期从官方文档、示例工程与教程语料挖掘)。关闭后按纯词面匹配度排序。"
        },
        "godotlsp.completion.useSingleQuotes": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "补全插入的字符串字面量用单引号(引擎 `text_editor/completion/use_single_quotes` 同名语义)。影响 `connect(\"sig\")` 等信号名面与参数选项面的插入文本。"
        },
        "godotlsp.completion.addStringNameLiterals": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "期望 `StringName` 的参数位自动给字符串加 `&` 前缀(如 `call(\"x\")` → `call(&\"x\")`)。"
        },
        "godotlsp.completion.addNodePathLiterals": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "期望 `NodePath` 的参数位自动给字符串加 `^` 前缀(如 `get_node(\"n\")` → `get_node(^\"n\")`)。"
        },
        "godotlsp.diagnostics.strict": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**预留(当前不生效)**:启用严格模式诊断,把默认关闭的可选警告(如未使用的信号参数)提升为可见警告。该能力依赖服务器端的警告诊断面,落地前此设置无效果——见 `docs/vscode-extension-roadmap.md` V2。"
        },
        "godotlsp.diagnostics.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "**预留(当前不生效)**:要忽略的诊断码列表(与 Godot 编辑器同款,如 `UNUSED_VARIABLE`、`SHADOWED_VARIABLE`)。该能力依赖服务器端的警告诊断面——当前服务器只产出错误级诊断,无码可过滤,见 `docs/vscode-extension-roadmap.md` V2。"
        },
        "godotlsp.inlayHints.typeHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "在推断出类型的 `:=` 绑定、未标注参数与 `for` 变量旁显示内联 `: 类型` 提示。"
        },
        "godotlsp.godotExecutable": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "machine-overridable",
          "markdownDescription": "「运行项目/运行当前场景」命令所用的 Godot 可执行文件路径。留空时使用 `PATH` 中的 `godot`。支持 `${workspaceFolder}` 与 `~`。"
        }
      }
    },
    "keybindings": [
      {
        "command": "godotlsp.switchSource",
        "key": "alt+o",
        "when": "editorTextFocus && (editorLangId == gdscript || editorLangId == godot-resource)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/tests/*.test.js\""
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
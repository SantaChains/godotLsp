{
  "name": "godotlsp",
  "displayName": "godotlsp:独立 GDScript 语言服务器",
  "description": "独立于 Godot 引擎运行的 GDScript 语言服务器:悬停文档、补全、导航、诊断与格式化,无需打开 Godot 编辑器。",
  "version": "0.1.0",
  "publisher": "godotlsp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/godotlsp",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "godot",
    "gdscript",
    "lsp",
    "language server",
    "gamedev"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "godotlsp 会运行由工作区配置的二进制文件。",
      "restrictedConfigurations": [
        "godotlsp.path"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "gdscript",
        "aliases": [
          "GDScript",
          "gdscript"
        ],
        "extensions": [
          ".gd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gdscript",
        "scopeName": "source.gdscript",
        "path": "./syntaxes/GDScript.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[gdscript]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": true,
        "editor.tabSize": 4
      }
    },
    "commands": [
      {
        "command": "godotlsp.restart",
        "title": "重启服务器",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.showOutput",
        "title": "显示输出",
        "category": "godotlsp"
      }
    ],
    "configuration": {
      "title": "godotlsp",
      "properties": {
        "godotlsp.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "machine-overridable",
          "markdownDescription": "`godotlsp` 服务器可执行文件的路径。留空时优先使用扩展自带二进制(server/),否则回退到 `PATH` 中的 `godotlsp`。支持 `${workspaceFolder}` 与 `~`。"
        },
        "godotlsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "关闭:不记录通信内容。",
            "消息:记录编辑器与 godotlsp 之间的 LSP 请求/响应。",
            "详细:在消息级别之上额外记录每个报文的完整内容。"
          ],
          "default": "off",
          "markdownDescription": "把编辑器与 godotlsp 之间的 LSP 通信记录到 **godotlsp** 输出通道,便于排查问题。"
        },
        "godotlsp.diagnostics.strict": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启用严格模式诊断:把默认关闭的可选警告(如未使用的信号参数)也提升为可见警告,便于在编写阶段收紧代码质量。"
        },
        "godotlsp.inlayHints.typeHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "在推断出类型的 `:=` 绑定、未标注参数与 `for` 变量旁显示内联 `: 类型` 提示。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}

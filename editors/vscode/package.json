{
  "name": "godotlsp",
  "displayName": "godotlsp:独立 GDScript 语言服务器",
  "description": "独立于 Godot 引擎运行的 GDScript 语言服务器:悬停文档、补全、导航、诊断与格式化,无需打开 Godot 编辑器。",
  "version": "0.1.1",
  "publisher": "SantaChains",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SantaChains/godotlsp",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "godot",
    "gdscript",
    "lsp",
    "language server",
    "gamedev"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "godotlsp 会运行由工作区配置的二进制文件。",
      "restrictedConfigurations": [
        "godotlsp.path",
        "godotlsp.godotExecutable"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "godotlsp",
          "title": "godotlsp",
          "icon": "./icons/godot_mono.svg"
        }
      ]
    },
    "views": {
      "godotlsp": [
        {
          "id": "godotlsp.symbols",
          "name": "当前文件符号"
        },
        {
          "id": "godotlsp.project",
          "name": "项目结构"
        },
        {
          "id": "godotlsp.scene",
          "name": "场景结构"
        }
      ]
    },
    "languages": [
      {
        "id": "gdscript",
        "aliases": [
          "GDScript",
          "gdscript"
        ],
        "extensions": [
          ".gd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "godot-resource",
        "aliases": [
          "Godot Resource",
          "godotresource"
        ],
        "extensions": [
          ".tscn",
          ".tres"
        ],
        "configuration": "./language-configurations/godot-resource.json"
      },
      {
        "id": "godot-project",
        "aliases": [
          "Godot Project",
          "godotproject"
        ],
        "extensions": [
          ".godot",
          ".import",
          ".gdextension",
          ".cfg"
        ],
        "configuration": "./language-configurations/godot-project.json"
      },
      {
        "id": "godot-uid",
        "aliases": [
          "Godot UID"
        ],
        "extensions": [
          ".uid"
        ],
        "configuration": "./language-configurations/godot-project.json"
      }
    ],
    "grammars": [
      {
        "language": "gdscript",
        "scopeName": "source.gdscript",
        "path": "./syntaxes/GDScript.tmLanguage.json"
      },
      {
        "language": "godot-resource",
        "scopeName": "source.godot.resource",
        "path": "./syntaxes/GodotResource.tmLanguage.json"
      },
      {
        "language": "godot-project",
        "scopeName": "source.godot.project",
        "path": "./syntaxes/GodotProject.tmLanguage.json"
      },
      {
        "language": "godot-uid",
        "scopeName": "source.godot.uid",
        "path": "./syntaxes/GodotUid.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gdscript",
        "path": "./snippets/gdscript.json"
      }
    ],
    "configurationDefaults": {
      "[gdscript]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": true,
        "editor.tabSize": 4
      },
      "[godot-resource]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": true,
        "editor.tabSize": 4
      }
    },
    "commands": [
      {
        "command": "godotlsp.restart",
        "title": "重启服务器",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.showOutput",
        "title": "显示输出",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.runProject",
        "title": "运行项目",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.runScene",
        "title": "运行当前场景",
        "category": "godotlsp"
      },
      {
        "command": "godotlsp.symbols.refresh",
        "title": "刷新符号",
        "category": "godotlsp",
        "icon": "$(refresh)"
      },
      {
        "command": "godotlsp.project.refresh",
        "title": "刷新项目结构",
        "category": "godotlsp",
        "icon": "$(refresh)"
      },
      {
        "command": "godotlsp.scene.refresh",
        "title": "刷新场景结构",
        "category": "godotlsp",
        "icon": "$(refresh)"
      },
      {
        "command": "godotlsp.goto",
        "title": "跳转到声明",
        "category": "godotlsp"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "godotlsp.symbols.refresh",
          "when": "view == godotlsp.symbols",
          "group": "navigation"
        },
        {
          "command": "godotlsp.project.refresh",
          "when": "view == godotlsp.project",
          "group": "navigation"
        },
        {
          "command": "godotlsp.scene.refresh",
          "when": "view == godotlsp.scene",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "godotlsp",
      "properties": {
        "godotlsp.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "machine-overridable",
          "markdownDescription": "`godotlsp` 服务器可执行文件的路径。留空时优先使用扩展自带二进制(server/),否则回退到 `PATH` 中的 `godotlsp`。支持 `${workspaceFolder}` 与 `~`。"
        },
        "godotlsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "关闭:不记录通信内容。",
            "消息:记录编辑器与 godotlsp 之间的 LSP 请求/响应。",
            "详细:在消息级别之上额外记录每个报文的完整内容。"
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "把编辑器与 godotlsp 之间的 LSP 通信记录到 **godotlsp** 输出通道,便于排查问题。"
        },
        "godotlsp.diagnostics.strict": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启用严格模式诊断:把默认关闭的可选警告(如未使用的信号参数)也提升为可见警告,便于在编写阶段收紧代码质量。"
        },
        "godotlsp.diagnostics.ignore": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "要忽略的诊断码列表(与 Godot 编辑器同款,如 `UNUSED_VARIABLE`、`SHADOWED_VARIABLE`),按码过滤推送的诊断。"
        },
        "godotlsp.inlayHints.typeHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "在推断出类型的 `:=` 绑定、未标注参数与 `for` 变量旁显示内联 `: 类型` 提示。"
        },
        "godotlsp.godotExecutable": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "machine-overridable",
          "markdownDescription": "「运行项目/运行当前场景」命令所用的 Godot 可执行文件路径。留空时使用 `PATH` 中的 `godot`。支持 `${workspaceFolder}` 与 `~`。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/tests/*.test.js\""
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
